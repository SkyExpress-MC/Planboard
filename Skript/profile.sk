options:
	noHelmet: red stained glass pane named "&cNo Helmet equipped"
	noChest: red stained glass pane named "&cNo Chestplate equipped"
	noLegs: red stained glass pane named "&cNo Leggings equipped"
	noBoots: red stained glass pane named "&cNo Boots equipped"

on join:
	cacheProfile(event-player)
	set {_prefix} to player's prefix
	set {_colors::*} to {_prefix} split at "&#"
	loop {_colors::*}:
		if length of loop-value >= 6:
			set {_hex} to first 6 characters of loop-value
			## Formats a stupid birdflop format with &# to eatable skript hexcolors...
			replace all "&#%{_hex}%" in {_prefix} with "<##%{_hex}%>"
	set {data::profile::rank::%player%} to colored {_prefix}

		
on quit:
	cacheProfile(event-player)

command /profile <offline player>:
	trigger:
		if arg-1 is not set:
			send "%{prefix}% &cPlease specify a player!"
			stop
		set {_target} to arg-1
		createProfileGui(player, {_target})	


function createProfileGui(p: player, target: offline player):
	set {_targetName} to "%{_target}%"
	set {_uuid} to {_target}'s uuid
	set {_helmet} to {data::profile::armor::helmet::%{_targetName}%} ? {@noHelmet}
	set {_chestplate} to {data::profile::armor::chestplate::%{_targetName}%} ? {@noChest}
	set {_leggings} to {data::profile::armor::leggings::%{_targetName}%} ? {@noLegs}
	set {_boots} to {data::profile::armor::boots::%{_targetName}%} ? {@noBoots}
	loop all players:
		if "%loop-player%" is {_targetName}:
			cacheProfile(loop-player)
			set {_helmet} to loop-player's helmet
			set {_chestplate} to loop-player's chestplate
			set {_leggings} to loop-player's leggings
			set {_boots} to loop-player's boots
			if {_helmet} is not set:
				set {_helmet} to {@noHelmet}
			else if {_helmet} is air:
				set {_helmet} to {@noHelmet}
			if {_chestplate} is not set:
				set {_chestplate} to {@noChest}
			else if {_chestplate} is air:
				set {_chestplate} to {@noChest}
			if {_leggings} is not set:
				set {_leggings} to {@noLegs}
			else if {_leggings} is air:
				set {_leggings} to {@noLegs}
			if {_boots} is not set:
				set {_boots} to {@noBoots}
			else if {_boots} is air:
				set {_boots} to {@noBoots}
	set {_rank} to {data::profile::rank::%{_targetName}%} ? "&7None"
	set {_balance} to {data::balance::%{_targetName}%} ? 0
	if {data::balance::%{_uuid}%} is set:
		if {_balance} is 0:
			set {_balance} to {data::balance::%{_uuid}%}
	set {_blocks} to {data::blocks_mined::%{_targetName}%} ? 0
	if {data::blocks_mined::%{_uuid}%} is set:
		if {_blocks} is 0:
			set {_blocks} to {data::blocks_mined::%{_uuid}%}
	set {_level} to {data::level::%{_targetName}%} ? 0
	if {data::level::%{_uuid}%} is set:
		if {_level} is 0:
			set {_level} to {data::level::%{_uuid}%}
	set {_prestige} to {data::prestige::%{_targetName}%} ? 0
	if {data::prestige::%{_uuid}%} is set:
		if {_prestige} is 0:
			set {_prestige} to {data::prestige::%{_uuid}%}
	set {_kills} to {data::kills::%{_targetName}%} ? 0
	if {data::kills::%{_uuid}%} is set:
		if {_kills} is 0:
			set {_kills} to {data::kills::%{_uuid}%}
	set {_deaths} to {data::deaths::%{_targetName}%} ? 0
	if {data::deaths::%{_uuid}%} is set:
		if {_deaths} is 0:
			set {_deaths} to {data::deaths::%{_uuid}%}
	set {_playtime} to formatProfilePlaytime({data::playtime::%{_targetName}%} ? time played of {_target})
	create a gui with id "profile::%{_p}'s uuid%" with virtual chest inventory with 6 rows named "&6&l%{_target}%'s Profile":
		loop 54 times:
			set {_slot} to loop-number - 1
			make gui slot {_slot} with black stained glass pane named "&7"
		make gui slot 10 with {_helmet}
		make gui slot 19 with {_chestplate}
		make gui slot 28 with {_leggings}
		make gui slot 37 with {_boots}
		make gui slot 13 with skull of {_target} named "&6&l%{_target}%" with lore "&8Player Overview" and "" and "&7Rank: %{_rank}%" and "&7Playtime: &e%{_playtime}%" and "" and "&eClick for perks and multipliers.":
			createProfileStatsGui({_p}, {_target})
		make gui slot 21 with experience bottle named "&b&lLevel" with lore "&8Progress" and "" and "&7Current: &b%formatNumbers({_level})%"
		make gui slot 22 with nether star named "&d&lPrestige" with lore "&8Rebirth" and "" and "&7Current: &d%formatNumbers({_prestige})%"
		make gui slot 23 with emerald named "&a&lBalance" with lore "&8Economy" and "" and "&7Balance: &a%formatNumbers({_balance})%"
		make gui slot 30 with golden pickaxe named "&e&lBlocks Mined" with lore "&8Mining" and "" and "&7Total: &6%formatNumbers({_blocks})%"
		make gui slot 31 with netherite sword named "&c&lKills" with lore "&8Combat" and "" and "&7PvP Kills: &c%formatNumbers({_kills})%"
		make gui slot 32 with totem of undying named "&4&lDeaths" with lore "&8Combat" and "" and "&7PvP Deaths: &4%formatNumbers({_deaths})%"
		make gui slot 39 with clock named "&6&lPlaytime" with lore "&8Activity" and "" and "&7Time Played: &e%{_playtime}%"
		make gui slot 40 with armor stand named "&d&lEquipped Armor" with lore "&8Current gear" and "" and "&7Shown on the left side."
		make gui slot 41 with book named "&6&lPerks & Multipliers" with lore "&8Detailed Profile" and "" and "&7View prestige skills," and "&7boosts, tokens, and streaks." and "" and "&eClick to open.":
			createProfileStatsGui({_p}, {_target})
		make gui slot 53 with barrier named "&cClose":
			close {_p}'s inventory
	open gui with id "profile::%{_p}'s uuid%" for {_p}

function createProfileStatsGui(p: player, target: offline player):
	set {_targetName} to "%{_target}%"
	set {_uuid} to {_target}'s uuid
	loop all players:
		if "%loop-player%" is {_targetName}:
			cacheProfile(loop-player)
	set {_level} to {data::level::%{_targetName}%} ? 0
	set {_pvp} to {data::pvp::%{_targetName}%} ? false
	set {_tokens} to {data::tokens::%{_uuid}%} ? 0
	set {_killstreak} to {killstreak::%{_uuid}%} ? 0
	set {_highestKillstreak} to {highestkillstreak::%{_uuid}%} ? 0
	set {_playtime} to formatProfilePlaytime({data::playtime::%{_targetName}%} ? time played of {_target})
	set {_rank} to {data::profile::rank::%{_targetName}%} ? "&7None"
	set {_healthSkill} to {data::prestige::skill::health::%{_targetName}%} ? 0
	set {_damageSkill} to {data::prestige::skill::damage::%{_targetName}%} ? 0
	set {_xpSkill} to {data::prestige::skill::xp::%{_targetName}%} ? 0
	set {_moneySkill} to {data::prestige::skill::money::%{_targetName}%} ? 0
	if {_healthSkill} > 10:
		set {_healthSkill} to 10
	if {_damageSkill} > 10:
		set {_damageSkill} to 10
	if {_xpSkill} > 20:
		set {_xpSkill} to 20
	if {_moneySkill} > 20:
		set {_moneySkill} to 20
	set {_xpMultiplier} to 1 + ({_prestige} * 0.25) + ({_xpSkill} * 0.15)
	if {_xpMultiplier} > 5:
		set {_xpMultiplier} to 5
	set {_moneyMultiplier} to 1 + ({_prestige} * 0.25) + ({_moneySkill} * 0.15)
	if {_moneyMultiplier} > 5:
		set {_moneyMultiplier} to 5
	set {_prestigeMultiplierBonus} to {_prestige} * 0.25
	set {_dropBonus} to {_prestige}
	if {_dropBonus} > 10:
		set {_dropBonus} to 10
	set {_bonusHealth} to {_healthSkill} * 2
	set {_bonusDamage} to {_damageSkill} * 0.5
	create a gui with id "profile-stats::%{_p}'s uuid%" with virtual chest inventory with 5 rows named "&d&l%{_target}%'s Perks":
		loop 45 times:
			set {_slot} to loop-number - 1
			make gui slot {_slot} with purple stained glass pane named "&7"
		make gui slot 10 with skull of {_target} named "&d&l%{_target}%'s Perks" with lore "&8Not repeated stats" and "" and "&7Rank: %{_rank}%" and "&7PvP: &c%{_pvp}%"
		make gui slot 11 with experience bottle named "&b&lXP Multiplier" with lore "&8Prestige Boost" and "" and "&7Multiplier: &bx%{_xpMultiplier}%" and "&7XP Skill: &f%{_xpSkill}%&8/&f20" and "&7Prestige Bonus: &b+%{_prestigeMultiplierBonus}%x" and "&8Cap: x5"
		make gui slot 12 with emerald named "&a&lMoney Multiplier" with lore "&8Economy Boost" and "" and "&7Multiplier: &ax%{_moneyMultiplier}%" and "&7Money Skill: &f%{_moneySkill}%&8/&f20" and "&7Prestige Bonus: &a+%{_prestigeMultiplierBonus}%x" and "&8Cap: x5"
		make gui slot 13 with diamond pickaxe named "&e&lDrop Bonus" with lore "&8Mining Boost" and "" and "&7Extra Drops: &e+%formatNumbers({_dropBonus})%" and "&8Cap: +10"
		make gui slot 14 with apple named "&c&lHealth Skill" with lore "&8Permanent Skill" and "" and "&7Owned: &f%{_healthSkill}%&8/&f10" and "&7Bonus Health: &c+%{_bonusHealth}%"
		make gui slot 15 with iron sword named "&6&lDamage Skill" with lore "&8Permanent Skill" and "" and "&7Owned: &f%{_damageSkill}%&8/&f10" and "&7Bonus Damage: &6+%{_bonusDamage}%"
		make gui slot 16 with amethyst shard named "&d&lTokens" with lore "&8Special Currency" and "" and "&7Tokens: &d%formatNumbers({_tokens})%"

		make gui slot 20 with blaze powder named "&c&lKillstreaks" with lore "&8PvP Streaks" and "" and "&7Current: &c%formatNumbers({_killstreak})%" and "&7Highest: &6%formatNumbers({_highestKillstreak})%"
		make gui slot 21 with shield named "&4&lPvP Status" with lore "&8Combat Toggle" and "" and "&7Enabled: &c%{_pvp}%"
		make gui slot 22 with clock named "&6&lActivity" with lore "&8Session History" and "" and "&7Playtime: &e%{_playtime}%"
		make gui slot 23 with chest named "&d&lArmor Cache" with lore "&8Profile Display" and "" and "&7Main menu shows current" and "&7or last saved armor."
		make gui slot 24 with nether star named "&d&lPrestige Skills" with lore "&8Permanent Choices" and "" and "&7Health: &c%{_healthSkill}%" and "&7Damage: &6%{_damageSkill}%" and "&7XP: &b%{_xpSkill}%" and "&7Money: &a%{_moneySkill}%"

		make gui slot 44 with barrier named "&cClose":
			close {_p}'s inventory
		make gui slot 40 with arrow named "&eBack to Profile":
			createProfileGui({_p}, {_target})
	open gui with id "profile-stats::%{_p}'s uuid%" for {_p}

function cacheProfile(p: player):
	if {_p}'s helmet is not set:
		delete {data::profile::armor::helmet::%{_p}%}
	else if {_p}'s helmet is air:
		delete {data::profile::armor::helmet::%{_p}%}
	else:
		set {data::profile::armor::helmet::%{_p}%} to {_p}'s helmet
	if {_p}'s chestplate is not set:
		delete {data::profile::armor::chestplate::%{_p}%}
	else if {_p}'s chestplate is air:
		delete {data::profile::armor::chestplate::%{_p}%}
	else:
		set {data::profile::armor::chestplate::%{_p}%} to {_p}'s chestplate
	if {_p}'s leggings is not set:
		delete {data::profile::armor::leggings::%{_p}%}
	else if {_p}'s leggings is air:
		delete {data::profile::armor::leggings::%{_p}%}
	else:
		set {data::profile::armor::leggings::%{_p}%} to {_p}'s leggings
	if {_p}'s boots is not set:
		delete {data::profile::armor::boots::%{_p}%}
	else if {_p}'s boots is air:
		delete {data::profile::armor::boots::%{_p}%}
	else:
		set {data::profile::armor::boots::%{_p}%} to {_p}'s boots
	set {data::playtime::%{_p}%} to time played of {_p}

function formatProfilePlaytime(t: timespan) :: text:
	set {_days} to 0
	set {_hours} to 0
	while {_t} >= 1 day:
		add 1 to {_days}
		remove 1 day from {_t}
	while {_t} >= 1 hour:
		add 1 to {_hours}
		remove 1 hour from {_t}
	return "%{_days}%d %{_hours}%h"
